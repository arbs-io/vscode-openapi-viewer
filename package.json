{
  "name": "vscode-openapi-viewer",
  "displayName": "vscode-openapi-viewer",
  "description": "A vscode extension to view openapi specifications",
  "version": "2.0.0",
  "publisher": "AndrewButson",
  "icon": "images/logo_128x128.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arbs-io/vscode-openapi-viewer.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/arbs-io"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "scripts": {
    "vscode:prepublish": "yarn esbuild-base --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2022",
    "esbuild": "yarn esbuild-base --sourcemap",
    "esbuild-watch": "yarn esbuild-base --sourcemap --watch",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p ./ --noEmit",
    "lint": "eslint src scripts",
    "package": "vsce package --no-yarn",
    "deploy": "vsce publish --no-yarn"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "contributes": {
    "menus": {
      "editor/title": [
        {
          "command": "openapi.showPreviewOpenApi",
          "when": "!activeEditorIsReadonly && openapi.isValid",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "openapi.showPreviewOpenApi",
        "title": "Show API Specification",
        "category": "openapi",
        "icon": {
          "light": "assets/openapi-icon-light.png",
          "dark": "assets/openapi-icon-dark.png"
        }
      }
    ],
    "configuration": {
      "title": "OpenAPI Viewer",
      "properties": {
        "openapi.preview.renderer": {
          "type": "string",
          "enum": [
            "scalar",
            "rapidoc"
          ],
          "default": "scalar",
          "enumDescriptions": [
            "Scalar: supports OpenAPI 3.2, 3.1, 3.0 and Swagger 2.0",
            "RapiDoc: the original renderer; supports up to OpenAPI 3.1"
          ],
          "markdownDescription": "Renderer used for the API preview. Use `rapidoc` to keep the previous look; OpenAPI 3.2 features (tag hierarchy, `QUERY` and additional operations, `querystring` parameters) require `scalar`."
        },
        "openapi.preview.markdownLineBreaks": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Render single newlines in `description` fields as line breaks (GitHub style). By default descriptions follow CommonMark, as required by the OpenAPI Specification, where a single newline is rendered as a space."
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
